---
import { getLocaleFromPath } from "@/i18n/locales";

const locale = getLocaleFromPath(Astro.url.pathname);
---
<section class="card-base px-6 py-16 mb-4 text-center onload-animation" data-pagefind-ignore>
    <h1 class="text-2xl font-bold text-75">{locale === "en" ? "No posts yet" : "还没有文章"}</h1>
</section>
